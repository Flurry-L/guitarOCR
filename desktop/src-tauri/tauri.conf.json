{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuitarOCR",
  "version": "0.2.2",
  "identifier": "io.github.flurry-l.guitarocr",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node sync-assets.mjs",
    "beforeBuildCommand": "node sync-assets.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/backend/": "backend/",
      "resources/uv/": "uv/",
      "resources/licenses/": "licenses/",
      "resources/models/": "models/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "乐谱识别与校对",
    "category": "Music",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "zlib"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.3"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
